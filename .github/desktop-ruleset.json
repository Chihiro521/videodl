{
  "name": "Desktop reviewed updates",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {"include": ["refs/heads/desktop"], "exclude": []}
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "Automation guard", "integration_id": 15368},
          {"context": "Desktop tests", "integration_id": 15368},
          {"context": "Dependency review", "integration_id": 15368},
          {"context": "CodeQL (python)", "integration_id": 15368},
          {"context": "CodeQL (javascript-typescript)", "integration_id": 15368},
          {"context": "CodeQL (actions)", "integration_id": 15368}
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {"tool": "CodeQL", "alerts_threshold": "none", "security_alerts_threshold": "high_or_higher"}
        ]
      }
    }
  ]
}
